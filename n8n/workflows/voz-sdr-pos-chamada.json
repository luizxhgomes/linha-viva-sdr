      "id": "d60d706c-bcf3-4e29-83c4-c74acf07e2f5",
      "name": "Webhook Retell Events",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        400
      ],
      "webhookId": "296e629c-0b25-4685-a200-6ffc64a6c01c"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst raw = $json.rawBody || JSON.stringify($json.body || {});\nconst sig = ($json.headers || {})['x-retell-signature'];\nconst keyEnv = $env.RETELL_API_KEY;\nif (keyEnv && sig) {\n  const exp = crypto.createHmac('sha256', keyEnv).update(raw).digest('hex');\n  if (sig !== exp) throw new Error('assinatura Retell invalida');\n}\nconst body = $json.body || $json;\nreturn [{ json: { event: body.event, call: body.call || {} } }];"
      },
      "id": "5374f46e-512c-41a0-80f4-5616a8258f81",
      "name": "Verificar assinatura",
