    {
      "parameters": {
        "jsCode": "const call = $json.call || {};\nconst cad = (call.call_analysis && call.call_analysis.custom_analysis_data) || {};\nconst proximo = cad.proximo_passo || (cad.opt_out ? 'remover_lista'\n  : (cad.agendou_reuniao ? 'agendar' : 'nurture'));\nreturn [{ json: {\n  call_id: call.call_id, recording_url: call.recording_url,\n  qualificado: cad.qualificado, segmento: cad.segmento,\n  qtd_clientes_base: cad.qtd_clientes_base, ja_indica_espontaneo: cad.ja_indica_espontaneo,\n  usa_crm: cad.usa_crm, agendou_reuniao: cad.agendou_reuniao,\n  data_hora_agendada: cad.data_hora_agendada, objecao_principal: cad.objecao_principal,\n  opt_out: cad.opt_out, sentimento: cad.sentimento, resumo: cad.resumo,\n  telefone: call.to_number, proximo_passo: proximo } }];"
      },
