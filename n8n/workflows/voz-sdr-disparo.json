      "parameters": {
        "jsCode": "const tz = 'America/Sao_Paulo';\nconst agora = new Date(new Date().toLocaleString('en-US', { timeZone: tz }));\nconst h = agora.getHours(); const dow = agora.getDay(); // 0=dom\nlet dentro = false;\nif (dow >= 1 && dow <= 5) dentro = (h >= 9 && h < 20);      // seg a sex 9-20\nelse if (dow === 6) dentro = (h >= 10 && h < 13);           // sab 10-13\n// domingo: nunca\nreturn [{ json: { ...$json, dentro_janela: dentro } }];"
      },
