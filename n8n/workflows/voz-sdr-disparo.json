    {
      "parameters": {
        "jsCode": "const from_number = \"+14706164413\";\nconst agent_id = \"agent_a32aac07fe9301318d015935d4\";\nlet d = String($json.telefone || '').replace(/\\D/g, '');\nif (d.startsWith('00')) d = d.slice(2);\nif (d.startsWith('55')) d = d.slice(2);\nif (d.length === 11 || d.length === 10) {\n  const ddd = d.slice(0, 2); let n = d.slice(2);\n  if (n.length === 8 && /^[6-9]/.test(n)) n = '9' + n; d = ddd + n;\n}\nconst to_number = '+55' + d;\nconst telefone_valido = /^\\+55\\d{2}9?\\d{8}$/.test(to_number);\nreturn [{ json: { ...$json, from_number, agent_id, to_number, telefone_valido } }];"
      },
