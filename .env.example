# ==============================================================
# Linha Viva — SDR de voz IA · variáveis de ambiente (TEMPLATE)
# --------------------------------------------------------------
# Copie para `.env` e preencha. O `.env` é gitignored — NUNCA
# comite valores reais. Em produção, use um cofre gerenciado:
# Vercel Environment Variables, GitHub Secrets, ou o cofre local
# do runner (ver SECURITY.md).
# ==============================================================

# ---- Retell AI (orquestração de voz) ----
RETELL_API_KEY=
RETELL_AGENT_ID=          # ex.: agent_xxxxxxxxxxxxxxxxxxxxxxxxxx
RETELL_LLM_ID=            # ex.: llm_xxxxxxxxxxxxxxxxxxxxxxxxxx
RETELL_VOICE_ID=          # ex.: custom_voice_xxxxxxxxxxxxxxxx

# ---- ElevenLabs (TTS / voz) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=      # id da voz custom no ElevenLabs

# ---- n8n (automação: disparo, pós-chamada, dashboard) ----
N8N_BASE_URL=            # ex.: https://n8n.seu-dominio.com
N8N_API_KEY=             # para criar/editar workflows via REST
N8N_MCP_URL=             # endpoint MCP do n8n (contém token — trate como segredo)
N8N_WEBHOOK_URL=         # ex.: https://n8n.seu-dominio.com/webhook

# ---- Telefonia (SIP trunk / Twilio-legado) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SIP_TERMINATION_URI=     # trunk BR (ex.: Nvoip/DirectCall) — ver docs/telefonia-adr.md
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=

# ---- Agendamento (opcional) ----
CALCOM_API_KEY=
